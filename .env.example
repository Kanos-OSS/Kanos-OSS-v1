# ---- Required ----

# PostgreSQL connection string.
# With the bundled docker-compose this is set for you.
DATABASE_URL=postgresql://kanos:kanos@localhost:5432/kanos

# API key for an OpenAI-compatible chat endpoint used for all text analysis,
# market research, and the report chat. The default model is openrouter's
# minimax/minimax-m2.5 (see server/openai.ts).
MINIMAX_KEY=

# ---- Optional ----

# Port the server listens on (default 15000).
PORT=15000

# Secret used to sign session cookies. Set a long random value in production.
SESSION_SECRET=change-me-in-production

# Google OAuth (only needed if you want the browser login flow; the headless
# API-key flow does not require these). Leave blank to disable OAuth.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Full callback URL registered with your Google OAuth app, e.g.
# https://your-domain.com/api/auth/google/callback
OAUTH_CALLBACK_URL=

# Vision model endpoint (only used to read uploaded images). OpenAI-compatible.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# Shopify integration (optional). Needed only for the OAuth "connect store" flow;
# you can also connect a store with a manual Admin API token at runtime.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
